# Copy values into untracked frontend/.env.local and backend/.env files.
# Use deployment-provider secret settings outside local development.
NEXT_PUBLIC_BACKEND_URL=http://localhost:8080
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080/api/v1
NEXT_PUBLIC_WS_URL=ws://localhost:8080/ws
DATABASE_URL=jdbc:postgresql://localhost:5432/kinetic
DATABASE_USERNAME=kinetic
DATABASE_PASSWORD=replace-with-a-local-secret
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_TIMEOUT=8h
ALLOWED_ORIGINS=http://localhost:3000
